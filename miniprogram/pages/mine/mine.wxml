<!-- pages/mine/mine.wxml — 我的页面 -->

<view class="mine-page">

  <!-- 用户卡片 -->
  <view class="user-card">
    <view class="user-avatar-wrap" bindtap="editProfile">
      <image
        wx:if="{{userInfo.avatar}}"
        class="user-avatar"
        src="{{userInfo.avatar}}"
        mode="aspectFill"
      ></image>
      <view wx:else class="user-avatar user-avatar-default">👤</view>
      <view class="user-avatar-badge">✎</view>
    </view>

    <view class="user-info" bindtap="editProfile">
      <view class="user-nickname">
        <text wx:if="{{userInfo.nickname}}">{{userInfo.nickname}}</text>
        <text wx:else class="user-nickname-empty">点击完善资料</text>
      </view>
      <view class="user-openid" wx:if="{{openidTail}}">ID ····{{openidTail}}</view>
      <view class="user-login-count" wx:else>已登录 {{userInfo.loginCount}} 次</view>
    </view>

    <view class="user-edit-btn" bindtap="editProfile">完善资料</view>
  </view>

  <!-- 数据概览 -->
  <view class="card overview-card">
    <view class="overview-ledger">
      <text class="overview-ledger-icon">{{isShared ? '👥' : '📒'}}</text>
      <text class="overview-ledger-name">{{currentLedgerName}}</text>
    </view>
    <view class="overview-row">
      <view class="overview-item">
        <text class="overview-value expense">¥{{todayExpense}}</text>
        <text class="overview-label">今日支出</text>
      </view>
      <view class="overview-divider"></view>
      <view class="overview-item">
        <text class="overview-value expense">¥{{monthExpense}}</text>
        <text class="overview-label">本月支出</text>
      </view>
      <view class="overview-divider"></view>
      <view class="overview-item">
        <text class="overview-value income">¥{{monthIncome}}</text>
        <text class="overview-label">本月收入</text>
      </view>
    </view>

    <!-- 预算进度 -->
    <view class="budget-mini" wx:if="{{hasBudget}}" bindtap="goToBudget">
      <view class="budget-mini-info">
        <text>本月预算已用 {{budgetPercent}}%</text>
        <text class="{{budgetRemaining >= 0 ? 'income' : 'expense'}}">剩余 ¥{{budgetRemaining}}</text>
      </view>
      <view class="budget-mini-track">
        <view class="budget-mini-fill {{budgetPercent > 100 ? 'over' : ''}}" style="width: {{budgetPercent}}%;"></view>
      </view>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="card menu-card">
    <view class="menu-item" bindtap="goToStats">
      <text class="menu-icon">📊</text>
      <view class="menu-body">
        <text class="menu-title">消费统计</text>
        <text class="menu-desc">日/周/月/年多维报表与趋势</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="goToLedger">
      <text class="menu-icon">👥</text>
      <view class="menu-body">
        <text class="menu-title">共享账本</text>
        <text class="menu-desc">和家人朋友一起记账，账单一目了然</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="goToBudget">
      <text class="menu-icon">🎯</text>
      <view class="menu-body">
        <text class="menu-title">预算管理</text>
        <text class="menu-desc">设置月度/年度预算，智能控费</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="goToExport">
      <text class="menu-icon">📤</text>
      <view class="menu-body">
        <text class="menu-title">账本导出</text>
        <text class="menu-desc">导出 CSV 账单，Excel/WPS 可打开</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="showAbout">
      <text class="menu-icon">ℹ️</text>
      <view class="menu-body">
        <text class="menu-title">关于</text>
        <text class="menu-desc">版本信息与说明</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="safe-bottom" style="height: 120rpx;"></view>
</view>
