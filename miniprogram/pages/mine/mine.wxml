<!-- pages/mine/mine.wxml — 我的页面 -->

<view class="mine-page">

  <!-- 用户卡片 -->
  <view class="user-card" wx:if="{{!editing}}">
    <view class="user-avatar-wrap" bindtap="openEdit">
      <image
        wx:if="{{userInfo.avatar}}"
        class="user-avatar"
        src="{{userInfo.avatar}}"
        mode="aspectFill"
      ></image>
      <view wx:else class="user-avatar user-avatar-default">👤</view>
      <view class="user-avatar-badge">✎</view>
    </view>

    <view class="user-info" bindtap="openEdit">
      <view class="user-nickname">
        <text wx:if="{{userInfo.nickname}}">{{userInfo.nickname}}</text>
        <text wx:else class="user-nickname-empty">点击完善资料</text>
      </view>
      <view class="user-openid" wx:if="{{openidTail}}">ID ····{{openidTail}}</view>
      <view class="user-login-count" wx:else>已登录 {{userInfo.loginCount}} 次</view>
    </view>

    <view class="user-edit-btn" bindtap="openEdit">修改资料</view>
  </view>

  <!-- 资料编辑面板：chooseAvatar + type="nickname"，微信当前唯一合规的昵称头像获取方式 -->
  <view class="pe-card" wx:else>
    <view class="pe-header">
      <text class="pe-title">编辑资料</text>
      <text class="pe-close" bindtap="closeEdit">✕</text>
    </view>

    <button
      class="pe-avatar-btn"
      open-type="chooseAvatar"
      bindchooseavatar="onChooseAvatar"
    >
      <image
        wx:if="{{form.avatar}}"
        class="pe-avatar"
        src="{{form.avatar}}"
        mode="aspectFill"
      ></image>
      <view wx:else class="pe-avatar pe-avatar-default">👤</view>
      <view class="pe-avatar-badge">✎</view>
    </button>
    <view class="pe-avatar-hint">点击更换头像</view>

    <view class="pe-field">
      <text class="pe-label">昵称</text>
      <input
        class="pe-input"
        type="nickname"
        value="{{form.nickname}}"
        placeholder="输入昵称，或使用微信昵称"
        placeholder-class="pe-placeholder"
        maxlength="12"
        bindinput="onNicknameInput"
        bindblur="onNicknameBlur"
      />
    </view>

    <view class="pe-tip">昵称会显示在共享账本的每一笔记录上，成员一看就知道是谁记的</view>

    <view class="pe-actions">
      <view class="pe-btn pe-btn-ghost" bindtap="closeEdit">取消</view>
      <view class="pe-btn pe-btn-primary {{saving ? 'is-saving' : ''}}" bindtap="saveEdit">
        {{saving ? '保存中' : '保存'}}
      </view>
    </view>
  </view>

  <!-- 功能入口。
       这里原有第一项「消费统计」，但统计页本来就是底部 tab，用户从 tab 直达更快，
       留着只是把同一个入口写两遍，已删除。
       原「数据概览」卡删掉后，当前账本身份在这一页彻底消失了（首页只在顶部账本栏显示），
       所以把「共享账本」这一项改成「当前账本」，顺带把账本名补回来。 -->
  <view class="card menu-card">
    <view class="menu-item" bindtap="goToLedger">
      <text class="menu-icon">{{isShared ? '👥' : '📒'}}</text>
      <view class="menu-body">
        <text class="menu-title">当前账本</text>
        <text class="menu-desc">{{currentLedgerName}}{{isShared ? ' · 共享账本' : ' · 个人账本'}}</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="goToBudget">
      <text class="menu-icon">🎯</text>
      <view class="menu-body">
        <text class="menu-title">预算管理</text>
        <text class="menu-desc">设置月度/年度预算，智能控费</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <!-- 导入页唯一的入口原本藏在导出页里，要导入得先点「导出」。
         这里改叫「导入导出」，把两条路径都摆到名字上。 -->
    <view class="menu-item" bindtap="goToExport">
      <text class="menu-icon">📤</text>
      <view class="menu-body">
        <text class="menu-title">导入导出</text>
        <text class="menu-desc">导入表格历史账单，或导出 CSV</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="showTips">
      <text class="menu-icon">🎙️</text>
      <view class="menu-body">
        <text class="menu-title">记账技巧</text>
        <text class="menu-desc">怎么说才能一次识别准确</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="showAbout">
      <text class="menu-icon">ℹ️</text>
      <view class="menu-body">
        <text class="menu-title">关于</text>
        <text class="menu-desc">版本信息与说明</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 页脚：版本与登录次数。这两条信息原来只有「关于」弹窗里才有，
       摊在页脚比每次弹窗更省事，也让页面有个收尾。 -->
  <view class="mine-footer">
    <text>语音记账 v1.1</text>
    <text wx:if="{{userInfo.loginCount}}"> · 已登录 {{userInfo.loginCount}} 次</text>
  </view>

  <view class="safe-bottom" style="height: 120rpx;"></view>
</view>
