/* pages/record/record.wxss — 语音记账页样式 */

.page-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  background: var(--color-bg-page);
  padding: 0 var(--spacing-md);
}

/* ============ 状态标题 ============ */

/* ============ 录入日期选择 ============ */
.date-selector {
  width: 100%;
  margin-bottom: var(--spacing-sm);
}

.date-selector-inner {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  padding: var(--spacing-sm) var(--spacing-md);
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

.date-selector-icon {
  font-size: 32rpx;
}

.date-selector-label {
  font-size: var(--font-sm);
  color: var(--color-text-hint);
}

.date-selector-value {
  flex: 1;
  text-align: right;
  font-size: var(--font-base);
  color: var(--color-text-primary);
  font-weight: 500;
}

.status-header {
  padding: var(--spacing-xl) 0 var(--spacing-md);
}

.status-text {
  font-size: var(--font-lg);
  color: var(--color-text-primary);
  font-weight: 600;
}

.status-text.recording {
  color: var(--color-primary);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.recording-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-primary);
  animation: blink 0.8s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

/* ============ 波形动画 ============ */
.wave-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-lg) 0;
}

.wave-container {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 200rpx;
}

.wave-bar {
  width: 8rpx;
  min-height: 12rpx;
  background: var(--color-primary);
  border-radius: 4rpx;
  animation: wave 0.6s ease-in-out infinite alternate;
}

@keyframes wave {
  0% { transform: scaleY(0.4); opacity: 0.4; }
  100% { transform: scaleY(1); opacity: 1; }
}

.wave-timer {
  margin-top: var(--spacing-sm);
  font-size: var(--font-sm);
  color: var(--color-text-hint);
}

/* ============ 语音文本显示 ============ */
.text-display {
  width: 100%;
  padding: var(--spacing-md);
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-md);
}

.raw-text-label {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

.raw-text {
  font-size: var(--font-lg);
  color: var(--color-text-primary);
  line-height: 1.6;
}

/* ============ 确认卡片 ============ */
.confirm-card {
  width: 100%;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg) var(--spacing-md);
  box-shadow: var(--shadow-md);
  margin-bottom: var(--spacing-md);
}

.confirm-amount-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: var(--spacing-md);
  border-bottom: 1rpx solid var(--color-divider);
  margin-bottom: var(--spacing-md);
}

.confirm-type {
  font-size: var(--font-sm);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
}

.confirm-type.expense {
  background: #FFF0F0;
  color: var(--color-expense);
}

.confirm-type.income {
  background: #F0FFF0;
  color: var(--color-income);
}

.confirm-amount {
  font-size: var(--font-hero);
  font-weight: 700;
}

.confirm-amount.expense { color: var(--color-expense); }
.confirm-amount.income { color: var(--color-income); }

/* 字段行 */
.confirm-field {
  padding: var(--spacing-sm) 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.confirm-field:last-of-type {
  border-bottom: none;
}

.confirm-field-label {
  font-size: var(--font-sm);
  color: var(--color-text-hint);
  margin-bottom: 8rpx;
  display: block;
}

.confirm-field-value {
  font-size: var(--font-base);
  color: var(--color-text-primary);
}

.arrow {
  margin-left: 8rpx;
  color: var(--color-text-hint);
  font-size: var(--font-lg);
}

/* 账本标签（确认卡片内） */
.ledger-tag {
  max-width: 360rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: var(--font-base);
  color: var(--color-primary);
  background: var(--color-primary-soft, rgba(7,193,96,0.12));
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.confirm-input {
  width: 100%;
  font-size: var(--font-base);
  padding: 8rpx 0;
}

/* 分类横向滚动 */
.category-scroll {
  width: 100%;
  white-space: nowrap;
}

.category-list {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 20rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-page);
  transition: all 0.2s;
  flex-shrink: 0;
}

.category-item.selected {
  background: var(--color-primary-light);
  border: 2rpx solid var(--color-primary);
}

.category-icon {
  font-size: 32rpx;
}

.category-name {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

/* 操作按钮 */
.confirm-actions {
  display: flex;
  gap: var(--spacing-md);
  margin-top: var(--spacing-lg);
}

.btn-cancel, .btn-save {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-base);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-cancel {
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
}

.btn-save {
  background: var(--color-primary);
  color: #FFFFFF;
}

/* ============ 语音按钮 ============ */
.voice-button-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xl) 0;
  margin-top: auto;
}

.main-voice-btn {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.voice-btn-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--color-primary);
  opacity: 0.1;
  transition: transform 0.3s ease;
}

.main-voice-btn.active .voice-btn-bg {
  animation: pulse 1.2s infinite;
}

@keyframes pulse {
  0% { transform: scale(1); opacity: 0.1; }
  50% { transform: scale(1.25); opacity: 0.25; }
  100% { transform: scale(1); opacity: 0.1; }
}

.voice-btn-front {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #07C160, #06AD56);
  box-shadow: 0 8rpx 32rpx rgba(7, 193, 96, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  transition: transform 0.15s ease;
}

.main-voice-btn:active .voice-btn-front {
  transform: scale(1.15);
}

.main-voice-btn.active .voice-btn-front {
  box-shadow: 0 8rpx 48rpx rgba(7, 193, 96, 0.6);
}

.voice-icon {
  font-size: 56rpx;
}

.voice-hint {
  margin-top: var(--spacing-md);
  font-size: var(--font-sm);
  color: var(--color-text-hint);
}

/* ============ 示例提示 ============ */
.example-section {
  width: 100%;
  padding: var(--spacing-md);
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-md);
}

.example-title {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-sm);
  display: block;
}

.example-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.example-item {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  background: var(--color-primary-light);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-round);
}

/* ============ 手动输入入口 ============ */
.manual-entry {
  padding: var(--spacing-md) 0;
}

.manual-link {
  font-size: var(--font-sm);
  color: var(--color-primary);
}
