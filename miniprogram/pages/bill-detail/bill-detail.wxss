/* pages/bill-detail/bill-detail.wxss — 账单详情与编辑 */
.page-container {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding: 0 var(--spacing-md);
}

.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.loading-text {
  font-size: var(--font-base);
  color: var(--color-text-hint);
}

/* ============ 金额卡片 ============ */
.amount-card {
  margin-top: var(--spacing-md);
  padding: var(--spacing-lg) var(--spacing-md);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  text-align: center;
}

.amount-type-row {
  margin-bottom: var(--spacing-sm);
}

.amount-type {
  display: inline-block;       /* 避免 text 标签默认 inline 跨行 */
  white-space: nowrap;         /* 强制“支出/收入”在一行，不被截断 */
  vertical-align: middle;
  font-size: var(--font-sm);
  padding: 4rpx 24rpx;
  border-radius: var(--radius-round);
  font-weight: 500;
  line-height: 1.4;
}

.amount-type.expense {
  background: #FFF0F0;
  color: var(--color-expense);
}

.amount-type.income {
  background: #F0FFF0;
  color: var(--color-income);
}

.amount-display {
  padding: var(--spacing-sm) 0;
}

.amount {
  font-size: 64rpx;
  font-weight: 700;
}

.amount.expense { color: var(--color-expense); }
.amount.income { color: var(--color-income); }

/* ============ 编辑模式 ============ */
.amount-edit {
  padding: var(--spacing-sm) 0;
}

.type-switcher {
  display: flex;
  gap: var(--spacing-sm);
  justify-content: center;
  margin-bottom: var(--spacing-md);
}

.type-btn {
  padding: 8rpx 40rpx;
  border-radius: var(--radius-round);
  font-size: var(--font-sm);
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
  border: 2rpx solid transparent;
}

.type-btn.active.expense {
  background: #FFF0F0;
  color: var(--color-expense);
  border-color: var(--color-expense);
}

.type-btn.active.income {
  background: #F0FFF0;
  color: var(--color-income);
  border-color: var(--color-income);
}

.amount-input-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.amount-prefix {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.amount-input {
  font-size: 48rpx;
  font-weight: 700;
  width: 300rpx;
  text-align: center;
}

/* ============ 详情卡片 ============ */
.detail-card {
  margin-top: var(--spacing-md);
  padding: var(--spacing-md);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.detail-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-sm) 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.detail-field:last-child {
  border-bottom: none;
}

.field-label {
  font-size: var(--font-sm);
  color: var(--color-text-hint);
  flex-shrink: 0;
}

.field-value {
  font-size: var(--font-base);
  color: var(--color-text-primary);
  text-align: right;
}

.field-value.hint {
  color: var(--color-text-hint);
}

.field-value-edit {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--font-base);
  color: var(--color-text-primary);
}

.arrow {
  color: var(--color-text-hint);
  font-size: var(--font-lg);
}

/* 查看模式：分类值 = 图标 + 名称 */
.category-value {
  display: flex;
  align-items: center;
}

.field-category-icon {
  font-size: 34rpx;
  margin-right: 10rpx;
}

/* 编辑模式：分类字段改为纵向布局（label 在上，网格在下） */
.detail-field-column {
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
}

.detail-field-column .field-label {
  margin-bottom: 4rpx;
  text-align: left;
}

/* 分类网格：多行铺开，全部选项直接可见可点
   （替代原横向 scroll-view：flex-end + overflow 会导致左侧选项滚不到被遮挡） */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
  width: 100%;
}

.category-grid .category-item {
  width: calc((100% - 48rpx) / 4);
  padding: 16rpx 8rpx;
  box-sizing: border-box;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 20rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-page);
  transition: all 0.2s;
  flex-shrink: 0;
}

.category-item.selected {
  background: var(--color-primary-light);
  border: 2rpx solid var(--color-primary);
}

.category-item .category-icon {
  font-size: 32rpx;
}

.category-item .category-name {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

/* 备注输入 */
.desc-input {
  flex: 1;
  text-align: right;
  font-size: var(--font-base);
  margin-left: var(--spacing-md);
}

/* ============ 操作按钮 ============ */
.action-bar {
  display: flex;
  gap: var(--spacing-md);
  margin-top: var(--spacing-lg);
  padding: 0 var(--spacing-md);
}

.action-bar button {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-base);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-edit {
  background: var(--color-bg-card);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary) !important;
}

.btn-delete {
  background: #FFF0F0;
  color: var(--color-expense);
}

.btn-cancel {
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
}

.btn-save {
  background: var(--color-primary);
  color: #FFFFFF;
}

.btn-save.disabled {
  opacity: 0.5;
}

.safe-bottom {
  height: 120rpx;
}
