<!-- pages/statistics/statistics.wxml — 统计报表页（日 / 月 / 年 三维度）
     原「周」维度已降级为月视图里的「近12周支出」小图，去掉一层嵌套切换；
     日视图只保留日历（走势图与日历功能重复，已移除）；
     饼图抽成 category-pie 组件，三个视图共用。 -->

<!-- 当前账本指示（统计只读展示，切换在首页） -->
<view class="ledger-indicator">
  <text class="ledger-indicator-icon">{{isShared ? '👥' : '📒'}}</text>
  <text class="ledger-indicator-name">{{currentLedgerName}}</text>
  <text class="ledger-indicator-hint">（在首页切换）</text>
</view>

<!-- 时间维度切换 -->
<view class="range-tabs">
  <view
    wx:for="{{rangeTabs}}"
    wx:key="key"
    class="range-tab {{activeRange === item.key ? 'active' : ''}}"
    data-range="{{item.key}}"
    bindtap="switchRange"
  >{{item.label}}</view>
</view>

<!-- 多维度汇总 -->
<view class="card stats-summary">
  <view class="summary-row">
    <view class="summary-item">
      <text class="summary-value expense">¥{{summary._fmtTotalExpense}}</text>
      <text class="summary-label">{{summary.label}}支出</text>
    </view>
    <view class="summary-divider"></view>
    <view class="summary-item">
      <text class="summary-value income">¥{{summary._fmtTotalIncome}}</text>
      <text class="summary-label">{{summary.label}}收入</text>
    </view>
    <view class="summary-divider"></view>
    <view class="summary-item">
      <text class="summary-value {{summary._balanceClass}}">{{summary._balanceSign}}¥{{summary._fmtBalance}}</text>
      <text class="summary-label">结余</text>
    </view>
  </view>
  <view class="summary-extra">
    <text>记账{{summary.recordCount}}笔 · {{summary.startDate}} ~ {{summary.endDate}}</text>
    <text wx:if="{{activeRange === 'month' && monthStats._fmtAvgDaily}}"> · 日均¥{{monthStats._fmtAvgDaily}} · 记账{{monthStats.daysWithRecords}}天</text>
  </view>
</view>

<!-- ==================== 日视图 ==================== -->
<block wx:if="{{activeRange === 'day'}}">
  <!-- 日历卡片 -->
  <view class="card calendar-card">
    <view class="card-header flex-between">
      <text class="card-title">📅 每日收支</text>
    </view>

    <!-- 月份切换 -->
    <view class="cal-nav">
      <view class="cal-nav-btn" bindtap="prevCalMonth">‹</view>
      <view class="cal-nav-title" bindtap="backToToday">{{calTitle}}</view>
      <view class="cal-nav-btn" bindtap="nextCalMonth">›</view>
    </view>

    <view class="cal-weekdays">
      <view class="cal-weekday" wx:for="{{calWeekdays}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="cal-grid">
      <view
        wx:for="{{calDays}}"
        wx:key="key"
        class="cal-cell {{item.empty ? 'empty' : ''}}"
        data-date="{{item.date}}"
        bindtap="tapCalDay"
      >
        <block wx:if="{{!item.empty}}">
          <view class="cal-day-num {{item.isToday ? 'today' : ''}} {{item.hasData ? 'has-data' : ''}}">{{item.day}}</view>
          <view class="cal-day-amounts">
            <view class="cal-day-money expense" wx:if="{{item.expense > 0}}">{{item._fmtExpense}}</view>
            <view class="cal-day-money income" wx:if="{{item.income > 0}}">{{item._fmtIncome}}</view>
          </view>
        </block>
      </view>
    </view>

    <view class="cal-total">
      <text class="cal-total-item">本月支出 <text class="expense">¥{{calMonthExpense}}</text></text>
      <text class="cal-total-item">本月收入 <text class="income">¥{{calMonthIncome}}</text></text>
    </view>

    <view class="chart-tip">点击日期查看当天账目明细 · ‹ › 切换月份 · 点击月份标题回到今天</view>
  </view>

  <category-pie
    list="{{categoryStats}}"
    total="{{_fmtTotalCategory}}"
    label="{{_categoryLabel}}"
    gradient="{{_pieGradient}}"
  />
</block>

<!-- ==================== 月视图 ==================== -->
<block wx:if="{{activeRange === 'month'}}">
  <!-- 月度消费趋势图 -->
  <view class="card chart-card">
    <view class="card-header flex-between">
      <text class="card-title">📈 月度消费趋势</text>
    </view>

    <view class="cal-nav">
      <view class="cal-nav-btn" bindtap="prevMonthPage">‹</view>
      <view class="cal-nav-title">{{monthTitle}}</view>
      <view class="cal-nav-btn {{monthOffset <= 0 ? 'disabled' : ''}}" bindtap="nextMonthPage">›</view>
    </view>

    <view class="bar-chart" wx:if="{{monthBars.length > 0}}">
      <scroll-view scroll-x class="bar-scroll">
        <view class="bar-container">
          <view
            wx:for="{{monthBars}}"
            wx:key="ym"
            class="bar-column"
            data-ym="{{item.ym}}"
            bindtap="tapMonthBar"
          >
            <view class="bar-value expense" wx:if="{{item.expense > 0}}">
              <text class="bar-value-text">{{item._fmtExpense}}</text>
            </view>
            <view class="bar {{item.expense > 0 ? 'active' : ''}}"
              style="height: {{item.barHeight}}rpx;">
            </view>
            <text class="bar-label">{{item.label}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="chart-tip">← 左右滑动查看更多月份 · 点击柱子查看该月支出分类 · ‹ 翻页查看更早历史 →</view>
    </view>

    <view class="empty-chart" wx:else>
      <text class="empty-icon">📈</text>
      <text>暂无月度支出数据</text>
    </view>
  </view>

  <!-- 近12周支出（原「周」维度降级为月视图内的小图） -->
  <view class="card chart-card">
    <view class="card-header flex-between">
      <text class="card-title">📊 近12周支出</text>
    </view>

    <view class="bar-chart" wx:if="{{recentWeeks.length > 0}}">
      <scroll-view scroll-x class="bar-scroll">
        <view class="bar-container">
          <view
            wx:for="{{recentWeeks}}"
            wx:key="date"
            class="bar-column"
          >
            <view class="bar-value expense" wx:if="{{item.expense > 0}}">
              <text class="bar-value-text">{{item._fmtExpense}}</text>
            </view>
            <view class="bar {{item.expense > 0 ? 'active' : ''}}"
              style="height: {{item.barHeight}}rpx;">
            </view>
            <text class="bar-label">{{item.label}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="chart-tip">← 左右滑动查看近12周 →</view>
    </view>

    <view class="empty-chart" wx:else>
      <text class="empty-icon">📊</text>
      <text>暂无周支出数据</text>
    </view>
  </view>

  <category-pie
    list="{{categoryStats}}"
    total="{{_fmtTotalCategory}}"
    label="{{_categoryLabel}}"
    gradient="{{_pieGradient}}"
  />

  <!-- 消费分析建议 -->
  <view class="card advice-card" wx:if="{{advices.length > 0}}">
    <view class="card-header flex-between">
      <text class="card-title">💡 消费分析</text>
      <text class="card-link" bindtap="goToBudget">设置预算 ›</text>
    </view>

    <view class="budget-bar" wx:if="{{budget}}">
      <view class="budget-bar-info">
        <text>本月预算 ¥{{budget.monthlyBudget}}</text>
        <text>已用 {{budgetPercent}}%</text>
      </view>
      <view class="budget-bar-track">
        <view
          class="budget-bar-fill {{budgetPercent > 100 ? 'over' : budgetPercent > 80 ? 'danger' : ''}}"
          style="width: {{budgetPercent > 100 ? 100 : budgetPercent}}%;"
        ></view>
      </view>
      <view class="budget-bar-detail">
        <text class="{{budgetRemaining >= 0 ? 'income' : 'expense'}}">
          剩余 ¥{{budgetRemaining >= 0 ? budgetRemaining : 0}}
        </text>
        <text wx:if="{{budgetRemaining < 0}}" class="expense">已超支 ¥{{-budgetRemaining}}</text>
      </view>
    </view>

    <view
      wx:for="{{advices}}"
      wx:key="text"
      class="advice-item"
    >
      <text class="advice-icon">{{item.icon}}</text>
      <text class="advice-text">{{item.text}}</text>
    </view>
  </view>
</block>

<!-- ==================== 年视图 ==================== -->
<block wx:if="{{activeRange === 'year'}}">
  <view class="card chart-card">
    <view class="card-header">
      <text class="card-title">📊 年度消费趋势</text>
    </view>

    <view class="bar-chart" wx:if="{{yearBars.length > 0}}">
      <view class="bar-container">
        <view
          wx:for="{{yearBars}}"
          wx:key="year"
          class="bar-column"
        >
          <view class="bar-value expense" wx:if="{{item.expense > 0}}">
            <text class="bar-value-text">{{item._fmtExpense}}</text>
          </view>
          <view class="bar {{item.expense > 0 ? 'active' : ''}}"
            style="height: {{item.barHeight}}rpx;">
          </view>
          <text class="bar-label">{{item.label}}</text>
        </view>
      </view>
      <view class="chart-tip">柱状图显示历年总支出对比</view>
    </view>

    <view class="empty-chart" wx:else>
      <text class="empty-icon">📊</text>
      <text>暂无年度支出数据</text>
    </view>
  </view>

  <category-pie
    list="{{categoryStats}}"
    total="{{_fmtTotalCategory}}"
    label="{{_categoryLabel}}"
    gradient="{{_pieGradient}}"
  />
</block>

<view class="safe-bottom" style="height: 120rpx;"></view>

<!-- ==================== 当天明细弹窗 ==================== -->
<view class="sheet-mask" wx:if="{{daySheet.visible}}" bindtap="closeDaySheet">
  <view class="sheet-panel" catchtap="noop">
    <view class="sheet-header">
      <text class="sheet-title">{{daySheet.date}} 账目明细</text>
      <text class="sheet-close" bindtap="closeDaySheet">✕</text>
    </view>

    <view class="sheet-summary" wx:if="{{!daySheet.loading}}">
      <text class="income">收入 ¥{{daySheet.totalIncome}}</text>
      <text class="expense">支出 ¥{{daySheet.totalExpense}}</text>
    </view>

    <scroll-view scroll-y class="sheet-list">
      <view wx:if="{{daySheet.loading}}" class="sheet-loading">加载中…</view>
      <block wx:elif="{{daySheet.list.length > 0}}">
        <view
          wx:for="{{daySheet.list}}"
          wx:key="_id"
          class="sheet-item"
        >
          <text class="sheet-item-icon">{{item._icon}}</text>
          <view class="sheet-item-body">
            <text class="sheet-item-name">{{item.categoryName}}<text class="sheet-item-desc" wx:if="{{item.description}}"> · {{item.description}}</text></text>
            <text class="sheet-item-time">{{item._time}}</text>
          </view>
          <text class="sheet-item-amount {{item.type === 'income' ? 'income' : 'expense'}}">{{item._sign}}¥{{item._fmtAmount}}</text>
        </view>
      </block>
      <view wx:else class="sheet-empty">当天暂无记账</view>
    </scroll-view>
  </view>
</view>

<!-- ==================== 月份分类弹窗 ==================== -->
<view class="sheet-mask" wx:if="{{monthSheet.visible}}" bindtap="closeMonthSheet">
  <view class="sheet-panel" catchtap="noop">
    <view class="sheet-header">
      <text class="sheet-title">{{monthSheet.title}}</text>
      <text class="sheet-close" bindtap="closeMonthSheet">✕</text>
    </view>

    <view class="sheet-summary">
      <text>总支出 ¥{{monthSheet.totalAmount}}</text>
    </view>

    <scroll-view scroll-y class="sheet-list">
      <block wx:if="{{monthSheet.categories.length > 0}}">
        <view
          wx:for="{{monthSheet.categories}}"
          wx:key="categoryId"
          class="sheet-item"
        >
          <view class="legend-dot" style="background-color: {{item._color}};"></view>
          <view class="sheet-item-body">
            <text class="sheet-item-name">{{item.categoryName}}</text>
          </view>
          <text class="sheet-item-amount expense">¥{{item._fmtAmount}}</text>
          <text class="sheet-item-pct">{{item.percentage}}%</text>
        </view>
      </block>
      <view wx:else class="sheet-empty">该月暂无支出</view>
    </scroll-view>
  </view>
</view>
