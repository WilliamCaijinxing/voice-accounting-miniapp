/* pages/statistics/statistics.wxss — 统计报表样式 */

/* ============ 当前账本指示 ============ */
.ledger-indicator {
  display: flex;
  align-items: center;
  padding: 16rpx var(--spacing-md);
  margin: var(--spacing-sm) var(--spacing-md) 0;
  background: var(--color-bg-card);
  border-radius: 16rpx;
  box-shadow: var(--shadow-sm);
}
.ledger-indicator-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}
.ledger-indicator-name {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-primary);
  max-width: 360rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ledger-indicator-hint {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  margin-left: 8rpx;
}

/* ============ 时间维度切换 ============ */
.range-tabs {
  display: flex;
  gap: var(--spacing-sm);
  padding: var(--spacing-md);
}

.range-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 16rpx;
  background: var(--color-bg-card);
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
  font-weight: 500;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s ease;
}

.range-tab.active {
  background: #07C160;
  color: #FFFFFF;
  font-weight: 600;
}

/* ============ 月份切换 ============ */
.month-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 var(--spacing-md) var(--spacing-sm);
  gap: var(--spacing-lg);
}

.month-nav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--color-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--color-text-secondary);
  box-shadow: var(--shadow-sm);
}

.month-nav-title {
  font-size: var(--font-xl);
  font-weight: 700;
  min-width: 200rpx;
  text-align: center;
}

/* ============ 汇总卡片 ============ */
.stats-summary {
  margin-bottom: var(--spacing-sm);
}

.summary-row {
  display: flex;
  justify-content: space-around;
  padding: var(--spacing-sm) 0;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.summary-value {
  font-size: var(--font-lg);
  font-weight: 700;
}

.summary-value.expense { color: var(--color-expense); }
.summary-value.income { color: var(--color-income); }

.summary-label {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

.summary-divider {
  width: 1rpx;
  background: var(--color-divider);
}

.summary-extra {
  text-align: center;
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid var(--color-divider);
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

/* ============ 图表卡片 ============ */
.chart-card {
  margin-bottom: var(--spacing-sm);
}

/* 卡片头部通用（页内补全，与首页一致） */
.card-header {
  padding-bottom: var(--spacing-sm);
  border-bottom: 1rpx solid var(--color-divider);
  margin-bottom: var(--spacing-sm);
}

.card-title {
  font-size: var(--font-base);
  font-weight: 600;
}

.card-link {
  font-size: var(--font-sm);
  color: var(--color-primary);
}

/* 饼图（conic-gradient 环形图） */
.pie-container {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

.pie-chart {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pie-center {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--color-bg-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.pie-total-label {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

.pie-total-amount {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-expense);
}

/* 图例 */
.pie-legend {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.legend-name {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  flex: 1;
}

.legend-amount {
  font-size: var(--font-sm);
  color: var(--color-text-primary);
  font-weight: 600;
}

.legend-pct {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  min-width: 60rpx;
  text-align: right;
}

/* ============ 柱状图 ============ */
.bar-chart {
  width: 100%;
}

.bar-scroll {
  width: 100%;
}

.bar-container {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  height: 260rpx;
  padding: 0 4rpx;
  min-width: 100%;
}

.bar-column {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 50rpx;
  flex-shrink: 0;
}

.bar-value {
  margin-bottom: 4rpx;
  font-size: 18rpx;
  color: var(--color-expense);
  white-space: nowrap;
}

.bar-value-text {
  writing-mode: vertical-rl;
  font-size: 18rpx;
}

.bar {
  width: 32rpx;
  border-radius: 6rpx 6rpx 0 0;
  background: var(--color-divider);
  transition: height 0.3s ease;
  min-height: 4rpx;
}

.bar.active {
  background: linear-gradient(180deg, #07C160, #06AD56);
}

.bar-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--color-text-hint);
}

/* ============ 空状态 ============ */
.empty-chart {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xl) 0;
  color: var(--color-text-hint);
  font-size: var(--font-sm);
}

.empty-chart .empty-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

/* ============ 消费分析建议 ============ */
.advice-card {
  margin-bottom: var(--spacing-sm);
}

.budget-bar {
  margin: var(--spacing-sm) 0;
}

.budget-bar-info {
  display: flex;
  justify-content: space-between;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.budget-bar-track {
  height: 16rpx;
  border-radius: 8rpx;
  background: var(--color-divider);
  overflow: hidden;
}

.budget-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #07C160, #06AD56);
  transition: width 0.4s ease;
}

.budget-bar-fill.danger {
  background: linear-gradient(90deg, #FFB03A, #FF9500);
}

.budget-bar-fill.over {
  background: linear-gradient(90deg, #FA5151, #E64340);
}

.budget-bar-detail {
  display: flex;
  gap: var(--spacing-md);
  margin-top: 8rpx;
  font-size: var(--font-xs);
}

.advice-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.advice-item:last-child {
  border-bottom: none;
}

.advice-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.advice-text {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--color-text-primary);
  line-height: 1.6;
}

/* ============ 日历视图 ============ */
.calendar-card {
  margin-bottom: var(--spacing-sm);
}

.card-hint {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

.cal-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-lg);
  padding-bottom: var(--spacing-sm);
}

.cal-nav-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-divider);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--color-text-secondary);
}

.cal-nav-btn.disabled {
  opacity: 0.3;
}

.cal-nav-title {
  font-size: var(--font-lg);
  font-weight: 700;
  min-width: 220rpx;
  text-align: center;
}

.cal-weekdays {
  display: flex;
  border-bottom: 1rpx solid var(--color-divider);
  padding-bottom: 8rpx;
  margin-bottom: 8rpx;
}

.cal-weekday {
  width: 14.285%;
  text-align: center;
  font-size: 20rpx;
  color: var(--color-text-hint);
}

.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-cell {
  width: 14.285%;
  min-height: 124rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6rpx 0;
  box-sizing: border-box;
  border-radius: 10rpx;
}

.cal-cell.empty {
  visibility: hidden;
}

.cal-cell:active {
  background: var(--color-bg-active, rgba(0, 0, 0, 0.04));
}

.cal-day-num {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-primary);
  border-radius: 50%;
}

.cal-day-num.today {
  background: #07C160;
  color: #FFFFFF;
  font-weight: 700;
}

.cal-day-num.has-data {
  font-weight: 600;
}

/* 日期数字下方：支出（红）在上、收入（绿）在下 */
.cal-day-amounts {
  margin-top: 2rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.cal-day-money {
  font-size: 18rpx;
  line-height: 1.25;
  max-width: 100%;
  padding: 0 2rpx;
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cal-day-money.expense { color: var(--color-expense); }
.cal-day-money.income { color: var(--color-income); }

/* 日历底部当月合计 */
.cal-total {
  display: flex;
  justify-content: space-around;
  margin-top: var(--spacing-sm);
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid var(--color-divider);
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

.cal-total-item { font-size: var(--font-xs); }

/* ============ 折线图 ============ */
.line-chart {
  display: flex;
  align-items: flex-start;
  padding-top: 8rpx;
}

/* 左侧 Y 轴刻度 */
.line-y-axis {
  position: relative;
  width: 68rpx;
  flex-shrink: 0;
}

.line-y-label {
  position: absolute;
  left: 0;
  width: 62rpx;
  text-align: right;
  font-size: 18rpx;
  color: var(--color-text-hint);
  transform: translateY(50%);
  white-space: nowrap;
}

.line-scroll {
  flex: 1;
  width: 100%;
  /* 不加 min-width:0 会导致 flex 子项被内容撑开、无法滚动 */
  min-width: 0;
}

.line-inner {
  position: relative;
  padding-bottom: 4rpx;
}

.line-plot {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.line-grid {
  position: absolute;
  left: 0;
  height: 1rpx;
  background: var(--color-divider);
}

/* 面积渐变填充（clip-path 由 JS 计算） */
.line-area {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  background: linear-gradient(180deg, rgba(7, 193, 96, 0.28), rgba(7, 193, 96, 0));
}

/* 折线段：以起点为旋转原点，长度/角度由 JS 在 rpx 坐标系下算出 */
.line-seg {
  position: absolute;
  height: 4rpx;
  border-radius: 2rpx;
  background: #C8C9CC;
  transform-origin: 0 50%;
}

.line-seg.active {
  background: linear-gradient(90deg, #07C160, #06AD56);
}

.line-dot {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-bg-card);
  border: 2rpx solid #C8C9CC;
  box-sizing: border-box;
}

.line-dot.active {
  background: #FFFFFF;
  border-color: #07C160;
  border-width: 3rpx;
}

/* 数值气泡（悬在点上，靠 topPad 留白避免裁切） */
.line-dot-tip {
  position: absolute;
  left: 50%;
  bottom: 16rpx;
  transform: translateX(-50%);
  font-size: 18rpx;
  color: var(--color-expense);
  white-space: nowrap;
}

.line-x-labels {
  position: relative;
  height: 40rpx;
  margin-top: 6rpx;
}

.line-x-label {
  position: absolute;
  top: 0;
  text-align: center;
  font-size: 18rpx;
  color: var(--color-text-hint);
}

/* ============ 子视图切换（周） ============ */
.sub-tabs {
  display: flex;
  gap: 8rpx;
  margin-bottom: var(--spacing-sm);
  background: var(--color-bg, #F6F6F6);
  border-radius: 12rpx;
  padding: 4rpx;
}

.sub-tab {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
  border-radius: 10rpx;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.sub-tab.active {
  background: #07C160;
  color: #FFFFFF;
  font-weight: 600;
}

/* 全年 52 周：更窄的柱子 */
.bar-container-wide {
  min-width: 1680rpx;
}

.bar-column-thin {
  width: 28rpx;
}

.bar-column-thin .bar {
  width: 18rpx;
}

.chart-tip {
  text-align: center;
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  padding-top: var(--spacing-sm);
}

/* ============ 半屏弹窗 ============ */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.sheet-panel {
  width: 100%;
  max-height: 75vh;
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  padding: var(--spacing-md);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: var(--spacing-sm);
  border-bottom: 1rpx solid var(--color-divider);
}

.sheet-title {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--color-text-primary);
}

.sheet-close {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-hint);
}

.sheet-summary {
  display: flex;
  gap: var(--spacing-lg);
  padding: var(--spacing-sm) 0;
  font-size: var(--font-sm);
  font-weight: 600;
}

.sheet-summary .income { color: var(--color-income); }
.sheet-summary .expense { color: var(--color-expense); }

.sheet-list {
  max-height: 52vh;
}

.sheet-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.sheet-item:last-child {
  border-bottom: none;
}

.sheet-item-icon {
  font-size: 36rpx;
  width: 52rpx;
  text-align: center;
  flex-shrink: 0;
}

.sheet-item-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

.sheet-item-name {
  font-size: var(--font-sm);
  color: var(--color-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sheet-item-desc {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

.sheet-item-time {
  font-size: 20rpx;
  color: var(--color-text-hint);
}

.sheet-item-amount {
  font-size: var(--font-sm);
  font-weight: 600;
  flex-shrink: 0;
}

.sheet-item-amount.income { color: var(--color-income); }
.sheet-item-amount.expense { color: var(--color-expense); }

.sheet-item-pct {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  min-width: 60rpx;
  text-align: right;
  flex-shrink: 0;
}

.sheet-loading,
.sheet-empty {
  text-align: center;
  padding: var(--spacing-xl) 0;
  font-size: var(--font-sm);
  color: var(--color-text-hint);
}
