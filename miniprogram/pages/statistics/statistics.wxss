/* pages/statistics/statistics.wxss — 统计报表样式 */

/* 分段器（支出/收入切换）与分类饼图组件共用同一份样式定义 */
@import "../../styles/segment.wxss";

/* ============ 当前账本指示 ============ */
.ledger-indicator {
  display: flex;
  align-items: center;
  padding: 16rpx var(--spacing-md);
  margin: var(--spacing-sm) var(--spacing-md) 0;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}
.ledger-indicator-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}
.ledger-indicator-name {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-primary);
  max-width: 360rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ledger-indicator-hint {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  margin-left: 8rpx;
}

/* ============ 时间维度切换 ============ */
.range-tabs {
  display: flex;
  gap: var(--spacing-sm);
  padding: var(--spacing-md);
}

.range-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
  font-weight: 500;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s ease;
}

.range-tab.active {
  background: #07C160;
  color: #FFFFFF;
  font-weight: 600;
}/* ============ 汇总卡片 ============ */
.stats-summary {
  margin-bottom: var(--spacing-sm);
}

.summary-row {
  display: flex;
  justify-content: space-around;
  padding: var(--spacing-sm) 0;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  /* 三等分 + 可收缩：数字位数变多时先压缩间距，不会把「结余」挤出卡片 */
  flex: 1;
  min-width: 0;
  padding: 0 4rpx;
}

/* 金额是这张卡唯一的主角，用 --font-xl 而不是 --font-lg：
   原来 32rpx 和下方 22rpx 的标签落差太小，扫一眼分不出哪个是数字。
   tabular-nums 让数字等宽，翻页或换账本时不会左右抖动。 */
.summary-value {
  font-size: var(--font-xl);
  font-weight: 700;
  letter-spacing: -0.5rpx;
  font-variant-numeric: tabular-nums;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-value.expense { color: var(--color-expense); }
.summary-value.income { color: var(--color-income); }

.summary-label {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

.summary-divider {
  width: 1rpx;
  background: var(--color-divider);
}

.summary-extra {
  text-align: center;
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid var(--color-divider);
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

/* ============ 图表卡片 ============ */

/* 卡片头部通用（页内补全，与首页一致） */
.card-header {
  padding-bottom: var(--spacing-sm);
  border-bottom: 1rpx solid var(--color-divider);
  margin-bottom: var(--spacing-sm);
}

.card-title {
  font-size: var(--font-base);
  font-weight: 600;
}

.card-link {
  font-size: var(--font-sm);
  color: var(--color-primary);
}/* 图例 *//* ============ 消费分析建议 ============ */
.advice-card {
  margin-bottom: var(--spacing-sm);
}

.budget-bar {
  margin: var(--spacing-sm) 0;
}

.budget-bar-info {
  display: flex;
  justify-content: space-between;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.budget-bar-track {
  height: 16rpx;
  border-radius: var(--radius-round);
  background: var(--color-divider);
  overflow: hidden;
}

.budget-bar-fill {
  height: 100%;
  border-radius: var(--radius-round);
  background: linear-gradient(90deg, #07C160, #06AD56);
  transition: width 0.4s ease;
}

.budget-bar-fill.danger {
  background: linear-gradient(90deg, #FFB03A, #FF9500);
}

.budget-bar-fill.over {
  background: linear-gradient(90deg, #FA5151, #E64340);
}

.budget-bar-detail {
  display: flex;
  gap: var(--spacing-md);
  margin-top: 8rpx;
  font-size: var(--font-xs);
}

.advice-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.advice-item:last-child {
  border-bottom: none;
}

.advice-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.advice-text {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--color-text-primary);
  line-height: 1.6;
}

/* ============ 日历视图 ============ */
.calendar-card {
  margin-bottom: var(--spacing-sm);
}.cal-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-lg);
  padding-bottom: var(--spacing-sm);
}

.cal-nav-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-divider);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--color-text-secondary);
}

.cal-nav-btn.disabled {
  opacity: 0.3;
}

.cal-nav-title {
  font-size: var(--font-lg);
  font-weight: 700;
  min-width: 220rpx;
  text-align: center;
}

.cal-weekdays {
  display: flex;
  border-bottom: 1rpx solid var(--color-divider);
  padding-bottom: 8rpx;
  margin-bottom: 8rpx;
}

.cal-weekday {
  width: 14.285%;
  text-align: center;
  font-size: 20rpx;
  color: var(--color-text-hint);
}

.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-cell {
  width: 14.285%;
  min-height: 124rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6rpx 0;
  box-sizing: border-box;
  border-radius: var(--radius-sm);
}

.cal-cell.empty {
  visibility: hidden;
}

.cal-cell:active {
  background: var(--color-bg-active, rgba(0, 0, 0, 0.04));
}

.cal-day-num {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-primary);
  border-radius: 50%;
}

.cal-day-num.today {
  background: #07C160;
  color: #FFFFFF;
  font-weight: 700;
}

.cal-day-num.has-data {
  font-weight: 600;
}

/* 日期数字下方：支出（红）在上、收入（绿）在下 */
.cal-day-amounts {
  margin-top: 2rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.cal-day-money {
  font-size: 18rpx;
  line-height: 1.25;
  max-width: 100%;
  padding: 0 2rpx;
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cal-day-money.expense { color: var(--color-expense); }
.cal-day-money.income { color: var(--color-income); }

/* 日历底部当月合计 */
.cal-total {
  display: flex;
  justify-content: space-around;
  margin-top: var(--spacing-sm);
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid var(--color-divider);
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

.cal-total-item { font-size: var(--font-xs); }/* 左侧 Y 轴刻度 *//* 面积渐变填充（clip-path 由 JS 计算） *//* 折线段：以起点为旋转原点，长度/角度由 JS 在 rpx 坐标系下算出 */.line-seg.active {
  background: linear-gradient(90deg, #07C160, #06AD56);
}.line-dot.active {
  background: #FFFFFF;
  border-color: #07C160;
  border-width: 3rpx;
}/* ============ 子视图切换（周） ============ */.sub-tab.active {
  background: #07C160;
  color: #FFFFFF;
  font-weight: 600;
}

.chart-tip {
  text-align: center;
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  padding-top: var(--spacing-sm);
}

/* ============ 半屏弹窗 ============ */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.sheet-panel {
  width: 100%;
  max-height: 75vh;
  background: #FFFFFF;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: var(--spacing-md);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: var(--spacing-sm);
  border-bottom: 1rpx solid var(--color-divider);
}

.sheet-title {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--color-text-primary);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 标题栏右侧：收支切换器 + 关闭按钮 */
.sheet-head-right {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  flex-shrink: 0;
}

/* 收支切换器改用公共分段器样式（styles/segment.wxss），此处不再单独定义 */

.sheet-close {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-hint);
}

.sheet-summary {
  display: flex;
  gap: var(--spacing-lg);
  padding: var(--spacing-sm) 0;
  font-size: var(--font-sm);
  font-weight: 600;
}

.sheet-summary .income { color: var(--color-income); }
.sheet-summary .expense { color: var(--color-expense); }

.sheet-list {
  max-height: 52vh;
}

/* 分类饼图弹窗的滚动区：分类多时不把弹窗撑出屏幕。
   flex + min-height:0 是必要的 —— 父级是 flex 纵向布局，
   不给收缩属性的话 max-height 会被内容顶开，滚动条不生效。 */
.sheet-scroll {
  flex: 1;
  min-height: 0;
  max-height: 60vh;
  padding-top: var(--spacing-sm);
}

.sheet-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.sheet-item:last-child {
  border-bottom: none;
}

.sheet-item-icon {
  font-size: 36rpx;
  width: 52rpx;
  text-align: center;
  flex-shrink: 0;
}

.sheet-item-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

.sheet-item-name {
  font-size: var(--font-sm);
  color: var(--color-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sheet-item-desc {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

.sheet-item-time {
  font-size: 20rpx;
  color: var(--color-text-hint);
}

.sheet-item-amount {
  font-size: var(--font-sm);
  font-weight: 600;
  flex-shrink: 0;
}

.sheet-item-amount.income { color: var(--color-income); }
.sheet-item-amount.expense { color: var(--color-expense); }

.sheet-loading,
.sheet-empty {
  text-align: center;
  padding: var(--spacing-xl) 0;
  font-size: var(--font-sm);
  color: var(--color-text-hint);
}

/* 弹窗取数失败。和 .load-error 同一套视觉语言（可点重试、文案中性），
   但不带页面级外边距 —— 弹窗面板本身已有 padding，再加会缩进两次。 */
.sheet-error {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-xl) 0;
}

.sheet-error-text {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.sheet-error-retry {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-primary);
}
