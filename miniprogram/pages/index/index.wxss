/* pages/index/index.wxss — 首页（语音记账主界面）样式
   已合并原 record.wxss 的录音 / 确认卡样式 */

/* ============ 账本切换栏 ============ */
.ledger-switch {
  display: flex;
  align-items: center;
  padding: var(--spacing-xs) var(--spacing-md) 0;
  gap: var(--spacing-sm);
}

.ledger-scroll {
  flex: 1;
  white-space: nowrap;
  display: flex;
}

.ledger-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 22rpx;
  margin-right: var(--spacing-xs);
  background: var(--color-bg-card, #FFFFFF);
  border: 1rpx solid var(--color-divider, #EEE);
  border-radius: 32rpx;
  font-size: var(--font-sm);
  color: var(--color-text-secondary, #666);
}

.ledger-chip.active {
  background: var(--color-primary-light, #E8F8EF);
  border-color: var(--color-primary, #07C160);
  color: var(--color-primary, #07C160);
  font-weight: 600;
}

.ledger-chip-icon { font-size: 24rpx; }

.ledger-manage {
  flex-shrink: 0;
  font-size: var(--font-sm);
  color: var(--color-primary, #07C160);
  padding-left: 8rpx;
}

/* ============ 今日概览卡片 ============ */
.hero-card {
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  margin: var(--spacing-md);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg) var(--spacing-md);
  color: #FFFFFF;
}

.hero-date {
  font-size: var(--font-xs);
  opacity: 0.85;
  margin-bottom: var(--spacing-sm);
}

.hero-summary {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: var(--spacing-sm) 0;
}

.hero-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.hero-label { font-size: var(--font-xs); opacity: 0.8; }
.hero-amount { font-size: var(--font-xl); font-weight: 700; }
.hero-amount.expense { color: #FFD4D4; }
.hero-amount.income { color: #D4FFD4; }
.hero-count { font-size: var(--font-lg); font-weight: 600; }

.hero-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 分类占比条 */
.category-bar {
  display: flex;
  margin-top: var(--spacing-md);
  height: 8rpx;
  border-radius: 4rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.2);
}

.category-bar-segment {
  min-width: 4rpx;
  transition: flex 0.3s ease;
}

.empty-today {
  padding: var(--spacing-sm) 0 0;
  text-align: center;
  opacity: 0.85;
}

.empty-text { font-size: var(--font-sm); }

/* ============ 语音记账区（视觉重心） ============ */
.voice-zone {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-sm) var(--spacing-md) var(--spacing-md);
}

/* ---------- 大号语音按钮 ---------- */
.main-voice-btn {
  position: relative;
  width: 260rpx;
  height: 260rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 双层呼吸光圈，让按钮在页面上足够醒目 */
.voice-halo {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--color-primary);
  opacity: 0.12;
  animation: halo 2.4s ease-out infinite;
}

.voice-halo-delay { animation-delay: 1.2s; }

@keyframes halo {
  0% { transform: scale(0.85); opacity: 0.22; }
  70% { transform: scale(1.18); opacity: 0; }
  100% { transform: scale(1.18); opacity: 0; }
}

.voice-core {
  position: relative;
  z-index: 1;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #07C160, #06AD56);
  box-shadow: 0 12rpx 40rpx rgba(7, 193, 96, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
}

.main-voice-btn:active .voice-core { transform: scale(0.94); }
.voice-core.recording { transform: scale(1.06); }

.voice-icon { font-size: 88rpx; }

.voice-main-hint {
  margin-top: var(--spacing-md);
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}

.voice-main-hint.recording { color: var(--color-primary); }

.voice-sub-hint {
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--color-text-hint);
}

.voice-extras {
  margin-top: var(--spacing-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.example-line {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

.manual-link {
  font-size: var(--font-sm);
  color: var(--color-primary);
}

/* ---------- 录音波形 ---------- */
.wave-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-sm) 0 var(--spacing-md);
}

.wave-container {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 140rpx;
}

.wave-bar {
  width: 8rpx;
  min-height: 12rpx;
  background: var(--color-primary);
  border-radius: 4rpx;
  animation: wave 0.6s ease-in-out infinite alternate;
}

@keyframes wave {
  0% { transform: scaleY(0.4); opacity: 0.4; }
  100% { transform: scaleY(1); opacity: 1; }
}

.wave-timer {
  margin-top: var(--spacing-sm);
  font-size: var(--font-sm);
  color: var(--color-text-hint);
}

/* ---------- 识别中 ---------- */
.parsing-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-lg) 0;
}

.parsing-spinner {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 8rpx solid var(--color-primary-light);
  border-top-color: var(--color-primary);
  animation: spin 0.9s linear infinite;
  margin-bottom: var(--spacing-md);
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ============ 确认卡片 ============ */
.confirm-card {
  width: 100%;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg) var(--spacing-md);
  box-shadow: var(--shadow-md);
}

.raw-text-line {
  padding-bottom: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
  border-bottom: 1rpx dashed var(--color-divider);
}

.raw-text-label {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

.raw-text {
  font-size: var(--font-base);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.confirm-amount-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: var(--spacing-md);
  border-bottom: 1rpx solid var(--color-divider);
}

.confirm-type {
  font-size: var(--font-sm);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
}

.confirm-type.expense { background: #FFF0F0; color: var(--color-expense); }
.confirm-type.income { background: #F0FFF0; color: var(--color-income); }

.confirm-amount { font-size: var(--font-hero); font-weight: 700; }
.confirm-amount.expense { color: var(--color-expense); }
.confirm-amount.income { color: var(--color-income); }

/* 记入账本提示（只读，切换在顶部账本栏） */
.confirm-ledger-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: var(--spacing-sm) 0 var(--spacing-xs);
}

.confirm-ledger-icon { font-size: 26rpx; }

.confirm-ledger-text {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

/* 字段行 */
.confirm-field {
  padding: var(--spacing-sm) 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.confirm-field:last-of-type { border-bottom: none; }

.confirm-field-label {
  font-size: var(--font-sm);
  color: var(--color-text-hint);
  margin-bottom: 8rpx;
  display: block;
}

.confirm-field-value {
  font-size: var(--font-base);
  color: var(--color-text-primary);
}

.arrow {
  margin-left: 8rpx;
  color: var(--color-text-hint);
  font-size: var(--font-lg);
}

.confirm-input {
  width: 100%;
  font-size: var(--font-base);
  padding: 8rpx 0;
}

/* 分类横向滚动 */
.category-scroll {
  width: 100%;
  white-space: nowrap;
}

.category-list {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 20rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-page);
  transition: all 0.2s;
  flex-shrink: 0;
}

.category-item.selected {
  background: var(--color-primary-light);
  border: 2rpx solid var(--color-primary);
}

.category-icon { font-size: 32rpx; }

.category-name {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

/* 操作按钮 */
.confirm-actions {
  display: flex;
  gap: var(--spacing-md);
  margin-top: var(--spacing-lg);
}

.btn-cancel, .btn-save {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-base);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-cancel {
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
}

.btn-save {
  background: var(--color-primary);
  color: #FFFFFF;
}

/* ============ 卡片通用 ============ */
.card { margin-bottom: 0; }

.card-header {
  padding-bottom: var(--spacing-sm);
  border-bottom: 1rpx solid var(--color-divider);
  margin-bottom: var(--spacing-sm);
}

.card-title { font-size: var(--font-base); font-weight: 600; }

.card-link {
  font-size: var(--font-sm);
  color: var(--color-primary);
}

/* ============ 本月账本卡（原预算卡 + 月概览卡合并） ============ */
.month-stats-row {
  display: flex;
  justify-content: space-around;
  padding: var(--spacing-sm) 0;
}

.month-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.month-stat-value { font-size: var(--font-lg); font-weight: 700; }
.month-stat-value.expense { color: var(--color-expense); }
.month-stat-value.income { color: var(--color-income); }

.month-stat-label {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

.budget-section {
  margin-top: var(--spacing-sm);
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid var(--color-divider);
}

.budget-bar-info {
  display: flex;
  justify-content: space-between;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.budget-bar-track {
  height: 16rpx;
  border-radius: 8rpx;
  background: var(--color-divider);
  overflow: hidden;
}

.budget-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #07C160, #06AD56);
  transition: width 0.4s ease;
}

.budget-bar-fill.danger { background: linear-gradient(90deg, #FFB03A, #FF9500); }
.budget-bar-fill.over { background: linear-gradient(90deg, #FA5151, #E64340); }

.budget-bar-detail {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  font-size: var(--font-xs);
}

.budget-bar-daily { color: var(--color-text-hint); }

.budget-setting-link {
  display: block;
  margin-top: var(--spacing-sm);
  font-size: var(--font-sm);
  color: var(--color-primary);
}

.no-budget {
  margin-top: var(--spacing-sm);
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid var(--color-divider);
  text-align: center;
}

/* ============ 最近账单 ============ */
.empty-recent {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xl) 0;
  color: var(--color-text-hint);
  font-size: var(--font-sm);
}

.empty-recent .empty-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}
