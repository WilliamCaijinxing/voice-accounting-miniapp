<!-- pages/index/index.wxml — 首页（语音记账主界面）
     已合并原「记账页」：录音 → 识别 → 确认 → 保存 全在本页闭环 -->

<!-- 账本切换栏 -->
<view class="ledger-switch">
  <scroll-view class="ledger-scroll" scroll-x="true" enable-flex="true">
    <view
      wx:for="{{ledgers}}"
      wx:key="id"
      class="ledger-chip {{currentLedgerId === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      data-type="{{item.type}}"
      data-name="{{item.name}}"
      data-role="{{item.role}}"
      bindtap="switchLedger"
    >
      <text class="ledger-chip-icon">{{item.type === 'shared' ? '👥' : '📒'}}</text>
      <text>{{item.name}}</text>
    </view>
  </scroll-view>
  <view class="ledger-manage" bindtap="goToLedger">管理 ›</view>
</view>

<!-- 刷新失败提示：放在数据之前，异常时先看到「这不是最新的」再看到数字 -->
<view class="load-error" wx:if="{{loadError}}">
  <text class="load-error-text">刷新失败，当前显示的可能不是最新数据</text>
  <text class="load-error-retry" bindtap="retryLoad">重试</text>
</view>

<!-- 今日概览卡片 -->
<view class="hero-card">
  <!-- 日期行右侧带一句本月概览：只占一行、不增加卡片高度。
       原来的「X月账本」整张卡（月支出/收入/结余 + 预算条）与统计页汇总卡、
       我的页概览卡讲的是同一组数字，三处重复，已删除。这里只保留"一眼知道大概"。 -->
  <view class="hero-top">
    <text class="hero-date">{{todayText}}</text>
    <text class="hero-month" wx:if="{{monthStats}}">本月已花 ¥{{monthStats._fmtTotalExpense}} · 日均 ¥{{monthStats._fmtAvgDaily}}</text>
  </view>
  <view class="hero-summary">
    <view class="hero-item">
      <text class="hero-label">今日支出</text>
      <text class="hero-amount expense">¥{{todayStats._fmtTotalExpense}}</text>
    </view>
    <view class="hero-divider"></view>
    <view class="hero-item">
      <text class="hero-label">今日收入</text>
      <text class="hero-amount income">¥{{todayStats._fmtTotalIncome}}</text>
    </view>
    <view class="hero-divider"></view>
    <view class="hero-item">
      <text class="hero-label">记账笔数</text>
      <text class="hero-count">{{todayStats.recordCount}}笔</text>
    </view>
  </view>

  <!-- 分类占比条 -->
  <view class="category-bar" wx:if="{{todayStats.categoryBreakdown.length > 0}}">
    <view
      wx:for="{{todayStats.categoryBreakdown}}"
      wx:key="categoryId"
      class="category-bar-segment"
      style="flex: {{item.amount}}; background-color: {{item._color}};"
    ></view>
  </view>

  <!-- 今天还没记账 -->
  <view class="empty-today" wx:if="{{todayStats.recordCount === 0 && !loading}}">
    <text class="empty-text">今天还没记账，按住下面的按钮说一句吧</text>
  </view>
</view>

<!-- 只读成员不能记账（P1-8）：把整个语音区收起来，换成一句说明。
     服务端已拦下写操作，前端不收口的话用户点下去才被拒，体验像是出了 bug。
     刻意不加图标 —— 专家团 P0-1 禁用 emoji 作功能图标，现存 emoji 属 P2-2 待清的老账。 -->
<view class="readonly-zone" wx:if="{{!_canRecord}}">
  <text class="readonly-title">你在「{{currentLedgerName}}」是只读成员</text>
  <text class="readonly-desc">可以查看账目和统计，但不能记账、改动或删除任何记录。</text>
  <text class="readonly-desc">如需记账权限，请让账本创建者在「账本管理」里把你改成「可记账」。</text>
</view>

<!-- ==================== 语音记账区（页面视觉重心） ==================== -->
<view class="voice-zone" wx:else>

  <!-- ---------- idle：大号语音按钮 ---------- -->
  <block wx:if="{{phase === 'idle'}}">
    <view
      class="main-voice-btn"
      bindtouchstart="startRecord"
      bindtouchend="stopRecord"
      bindtouchcancel="stopRecord"
    >
      <view class="voice-halo"></view>
      <view class="voice-halo voice-halo-delay"></view>
      <view class="voice-core">
        <text class="voice-icon">🎤</text>
      </view>
    </view>
    <text class="voice-main-hint">按住说话，直接记账</text>
    <text class="voice-sub-hint">松手自动识别金额和分类</text>

    <view class="voice-extras">
      <text class="example-line">试试说：午餐35元 · 打车25块 · 工资到账15000</text>
      <text class="manual-link" bindtap="openManualInput">不想说话？手动记账 ›</text>
    </view>
  </block>

  <!-- ---------- recording：波形 + 计时 ---------- -->
  <block wx:if="{{phase === 'recording'}}">
    <view class="wave-area">
      <view class="wave-container">
        <view
          class="wave-bar"
          wx:for="{{waves}}"
          wx:key="*this"
          style="animation-delay: {{index * 0.08}}s; height: {{item}}%;"
        ></view>
      </view>
      <text class="wave-timer">{{recordingTime}}s</text>
    </view>
    <view
      class="main-voice-btn active"
      bindtouchend="stopRecord"
      bindtouchcancel="stopRecord"
    >
      <view class="voice-halo"></view>
      <view class="voice-halo voice-halo-delay"></view>
      <view class="voice-core recording">
        <text class="voice-icon">🔊</text>
      </view>
    </view>
    <text class="voice-main-hint recording">松手结束录音</text>
  </block>

  <!-- ---------- parsing：识别中 ---------- -->
  <block wx:if="{{phase === 'parsing'}}">
    <view class="parsing-area">
      <view class="parsing-spinner"></view>
      <text class="voice-main-hint">正在识别...</text>
      <text class="voice-sub-hint" wx:if="{{rawText}}">{{rawText}}</text>
    </view>
  </block>

  <!-- ---------- confirm：确认卡片 ---------- -->
  <view class="confirm-card" wx:if="{{phase === 'confirm' && parsed}}">
    <!-- 识别原文 -->
    <view class="raw-text-line" wx:if="{{rawText}}">
      <text class="raw-text-label">识别内容：</text>
      <text class="raw-text">{{rawText}}</text>
    </view>

    <view class="confirm-amount-row">
      <text class="confirm-type {{parsed.type === 'income' ? 'income' : 'expense'}}">
        {{parsed.type === 'income' ? '收入' : '支出'}}
      </text>
      <view class="confirm-amount-edit {{parsed.type === 'income' ? 'income' : 'expense'}}">
        <text class="confirm-amount-sign">{{parsed._sign}}¥</text>
        <input
          class="confirm-amount-input"
          type="digit"
          value="{{parsed.amountText}}"
          placeholder="0.00"
          placeholder-class="confirm-amount-ph"
          bindinput="onAmountInput"
          bindblur="onAmountBlur"
        />
      </view>
    </view>

    <!-- 金额可改：语音识别最易出错的恰是数字，识别错了不该逼用户整句重说 -->
    <text class="confirm-amount-hint">识别有误？直接点上面的金额修改</text>

    <!-- 记入哪个账本（只读提示，切换请用顶部账本栏） -->
    <view class="confirm-ledger-tip">
      <text class="confirm-ledger-icon">{{currentLedgerId ? '👥' : '📒'}}</text>
      <text class="confirm-ledger-text">记入「{{currentLedgerName}}」</text>
    </view>

    <!-- 分类选择 -->
    <view class="confirm-field">
      <text class="confirm-field-label">分类</text>
      <scroll-view class="category-scroll" scroll-x>
        <view class="category-list">
          <view
            wx:for="{{categories}}"
            wx:key="id"
            class="category-item {{parsed.categoryId === item.id ? 'selected' : ''}}"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
            bindtap="selectCategory"
          >
            <text class="category-icon">{{item.icon}}</text>
            <text class="category-name">{{item.name}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 日期 -->
    <picker mode="date" value="{{parsed.date}}" start="2020-01-01" end="{{todayStr}}" bindchange="onDateChange">
      <view class="confirm-field flex-between">
        <text class="confirm-field-label">日期</text>
        <view class="confirm-field-value flex-row">
          <text>{{parsed.date}}</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </picker>

    <!-- 备注 -->
    <view class="confirm-field">
      <text class="confirm-field-label">备注</text>
      <input
        class="confirm-input"
        value="{{parsed.description}}"
        placeholder="添加备注..."
        bindinput="onDescInput"
      />
    </view>

    <!-- 操作按钮 -->
    <view class="confirm-actions">
      <button class="btn-cancel" bindtap="resetRecord">重新录入</button>
      <button class="btn-save" bindtap="saveExpense">确认保存</button>
    </view>
  </view>

</view>

<!-- 最近账单 -->
<view class="card">
  <view class="card-header flex-between">
    <text class="card-title">最近账单</text>
    <!-- 总数取自服务端 count；此处列表只展示最近 10 条，不能用 recentList.length 当总数 -->
    <text class="card-link" wx:if="{{recentTotal > 0}}">共{{recentTotal}}笔</text>
  </view>

  <block wx:if="{{recentList.length > 0}}">
    <expense-card
      wx:for="{{recentList}}"
      wx:key="_id"
      item="{{item}}"
      bind:tap="onExpenseTap"
    />
  </block>

  <view class="empty-recent" wx:else>
    <text class="empty-icon">📋</text>
    <text>暂无账单记录</text>
  </view>
</view>

<!-- 底部安全区 -->
<view class="safe-bottom" style="height: 120rpx;"></view>

<!-- 保存后撤销条：固定底部，5s 倒计时结束自动收起 -->
<view class="undo-bar" wx:if="{{undo}}">
  <view class="undo-bar-info">
    <text class="undo-bar-text">{{undo._text}}</text>
    <text class="undo-bar-amount {{undo._typeClass}}">{{undo._amount}}</text>
  </view>
  <text class="undo-bar-btn" bindtap="undoExpense">撤销</text>
  <view class="undo-bar-progress">
    <view class="undo-bar-progress-fill" style="width: {{undo._progress}};"></view>
  </view>
</view>
