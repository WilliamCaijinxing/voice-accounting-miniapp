/* components/category-pie/category-pie.wxss
   组件样式默认隔离，app.wxss 的全局类不会作用到组件内节点，
   因此这里自带 .card 的定义（与 app.wxss 保持一致）。 */

.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
  margin: var(--spacing-sm) var(--spacing-md);
  box-shadow: var(--shadow-sm);
}

.chart-card {
  margin-bottom: var(--spacing-sm);
}

/* plain 模式：弹窗内嵌用，不要卡片外壳和外边距 */
.cp-plain {
  padding: 0;
}

.card-header {
  padding-bottom: var(--spacing-sm);
  border-bottom: 1rpx solid var(--color-divider);
  margin-bottom: var(--spacing-sm);
}

/* 卡片头一行：左边标题，右边收支切换器 */
.cp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-sm);
}

.card-title {
  font-size: var(--font-base);
  font-weight: 600;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 收支切换器（胶囊分段器） ----------
   容器与滑块都用 --radius-round：半径恒等于半高，将来调高度也不会变成长圆角方块。 */
.cp-tabs {
  display: flex;
  flex-shrink: 0;
  padding: 4rpx;
  background: var(--color-bg-page);
  border-radius: var(--radius-round);
}

.cp-tab {
  padding: 6rpx 20rpx;
  border-radius: var(--radius-round);
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  line-height: 1.4;
  transition: background 0.15s ease, color 0.15s ease;
}

.cp-tab.active {
  background: var(--color-bg-card);
  color: var(--color-text-primary);
  font-weight: 600;
  box-shadow: var(--shadow-sm);
}

/* 饼图（conic-gradient 环形图） */
.pie-container {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

.pie-chart {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pie-center {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  background: var(--color-bg-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.pie-total-label {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}

/* 金额是这张卡的主角，用 --font-xl 而不是 --font-lg：
   原来 32rpx 在 152rpx 的圆环里显得局促，和右侧图例的金额几乎同级，读起来没有主次。
   tabular-nums 让数字等宽，位数变化时不会左右跳动。 */
.pie-total-amount {
  font-size: var(--font-xl);
  font-weight: 700;
  letter-spacing: -0.5rpx;
  font-variant-numeric: tabular-nums;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pie-total-amount.expense { color: var(--color-expense); }
.pie-total-amount.income { color: var(--color-income); }

/* 图例 */
.pie-legend {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: var(--radius-xs);
  flex-shrink: 0;
}

.legend-name {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  flex: 1;
}

.legend-amount {
  font-size: var(--font-sm);
  color: var(--color-text-primary);
  font-weight: 600;
}

.legend-pct {
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  min-width: 60rpx;
  text-align: right;
}

/* 空状态 */
.empty-chart {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xl) 0;
  color: var(--color-text-hint);
  font-size: var(--font-sm);
}

.empty-chart .empty-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}
