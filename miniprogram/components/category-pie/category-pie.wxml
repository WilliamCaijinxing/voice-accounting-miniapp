<!-- components/category-pie/category-pie.wxml — 分类饼图（支出 / 收入二选一）
     两种外壳：
       - 默认：自带 .card 卡片 + 卡片头（含收支切换器），用于统计页正文
       - plain：无卡片无标题，供底部弹窗内嵌；切换器由调用方画在弹窗标题栏右上角 -->

<view class="{{plain ? 'cp-plain' : 'card chart-card'}}">
  <view class="card-header cp-head" wx:if="{{!plain}}">
    <text class="card-title">{{icon}} {{label}}</text>

    <view class="cp-tabs" wx:if="{{showTabs}}">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="cp-tab {{type === item.key ? 'active' : ''}}"
        data-type="{{item.key}}"
        bindtap="onSwitch"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="pie-container" wx:if="{{!view.empty}}">
    <view class="pie-chart" style="background: {{view.gradient}};">
      <view class="pie-center">
        <text class="pie-total-label">{{view.totalLabel}}</text>
        <text class="pie-total-amount {{view.isIncome ? 'income' : 'expense'}}">¥{{view.total}}</text>
      </view>
    </view>

    <view class="pie-legend">
      <view
        wx:for="{{view.list}}"
        wx:key="categoryId"
        class="legend-item"
      >
        <view class="legend-dot" style="background-color: {{item._color}};"></view>
        <text class="legend-name">{{item.categoryName}}</text>
        <text class="legend-amount">¥{{item._fmtAmount}}</text>
        <text class="legend-pct">{{item.percentage}}%</text>
      </view>
    </view>
  </view>

  <view class="empty-chart" wx:else>
    <text class="empty-icon">📊</text>
    <text>{{view.emptyText}}</text>
  </view>
</view>
