/* components/trend-bars/trend-bars.wxss — 竖向分组柱状图
   组件样式默认隔离，页面/全局的 .card 等类不会作用到这里，因此自带卡片样式
   （与 app.wxss 的 .card 保持一致）。CSS 变量定义在 page 选择器上，
   自定义属性会继承进组件，可以正常使用。

   尺寸口径：绘图区高度 320rpx、X 轴标签带 34rpx。
   Y 轴刻度的 top 百分比与柱高百分比共用同一套换算（见页面 buildTrendChart），
   任何一处改动都必须同步，否则刻度线和柱子会对不齐。 */

.tbx-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
  margin: var(--spacing-sm) var(--spacing-md);
  box-shadow: var(--shadow-sm);
}

/* ============ 卡片头 ============ */
.tbx-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: var(--spacing-sm);
  border-bottom: 1rpx solid var(--color-divider);
}

.tbx-title {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text-primary);
}

.tbx-legend {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.tbx-legend-item {
  display: flex;
  align-items: center;
}

.tbx-legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.tbx-legend-dot.income { background: var(--color-income); }
.tbx-legend-dot.expense { background: var(--color-expense); }

.tbx-legend-text {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

/* ============ 翻页条 ============ */
.tbx-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-lg);
  padding: var(--spacing-sm) 0;
}

.tbx-nav-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--color-bg-page);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--color-text-secondary);
}

.tbx-nav-btn.is-disabled {
  opacity: 0.3;
}

.tbx-nav-title {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  font-weight: 500;
}

/* ============ 绘图区 ============ */
.tbx-plot {
  display: flex;
  padding-top: 16rpx;
}

/* Y 轴：与柱状区等高，刻度用百分比定位，天然与网格线对齐 */
.tbx-yaxis {
  position: relative;
  width: 68rpx;
  flex-shrink: 0;
  height: 320rpx;
}

.tbx-ytick {
  position: absolute;
  right: 12rpx;
  transform: translateY(-50%);
  font-size: 20rpx;
  color: var(--color-text-hint);
  white-space: nowrap;
}

.tbx-body {
  position: relative;
  flex: 1;
  min-width: 0;
}

.tbx-grid {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 320rpx;
}

.tbx-gridline {
  position: absolute;
  left: 0;
  right: 0;
  height: 0;
  border-top: 1rpx dashed #E9E9E9;
}

/* 0 值基线用实线，视觉上"地面"更明确 */
.tbx-gridline.is-base {
  border-top-style: solid;
  border-top-color: #E2E2E2;
}

.tbx-groups {
  position: relative;
  display: flex;
  height: 354rpx;
}

.tbx-group {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.tbx-bars {
  height: 320rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 4rpx;
}

/* 柱宽用百分比 + 上限：12 组时约 16rpx，2 组时不会变成两根宽条 */
.tbx-bar {
  width: 30%;
  max-width: 22rpx;
  min-width: 6rpx;
  border-radius: var(--radius-xs) var(--radius-xs) 0 0;
}

.tbx-bar.income { background: var(--color-income); }
.tbx-bar.expense { background: var(--color-expense); }

.tbx-xlabel {
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  font-size: 18rpx;
  color: var(--color-text-hint);
  white-space: nowrap;
}

/* 密集区间只显示间隔刻度，但格子仍占位，保证柱组等宽 */
.tbx-xlabel.is-hidden {
  visibility: hidden;
}

/* ============ 选中指示线与浮层 ============ */
/* 指示线用中性灰，不用收入色——它只是个"游标"，
   一旦染成绿/红就会被读成某条数据序列 */
.tbx-indicator {
  position: absolute;
  top: 0;
  bottom: 34rpx;
  width: 2rpx;
  background: #BFBFBF;
  opacity: 0.9;
  z-index: 2;
  pointer-events: none;
}

/* 浮层贴在指示线的「外侧」：左半区的组往右放，右半区的组往左放，
   这样它永远不压住用户正在看的那组柱子。
   28rpx 的间距必须大于柱组半宽（最大 2×22rpx + 4rpx，半宽 24rpx），
   否则极窄的年份视图里仍会蹭到边柱。
   底色半透明 + 磨砂：即使浮层和别的柱子重叠，柱子也要透出来 ——
   完全不透明时用户会失去"我现在在整张图的哪个位置"的参照。
   0.78 是平衡点：再高就开始挡视线，再低文字会发灰。
   iOS 走 backdrop-filter 磨砂，Android WebView 不支持时会退化成纯半透明，两种都可读。 */
.tbx-tooltip {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  min-width: 240rpx;
  padding: 16rpx 20rpx 12rpx;
  background: rgba(255, 255, 255, 0.78);
  -webkit-backdrop-filter: blur(20rpx);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(17, 24, 20, 0.07);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md);
  z-index: 10;
}

.tbx-tooltip.is-right {
  margin-left: 28rpx;
}

.tbx-tooltip.is-left {
  transform: translate(-100%, -50%);
  margin-left: -28rpx;
}

.tbx-tooltip-title {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 4rpx;
  white-space: nowrap;
}

.tbx-tooltip-row {
  display: flex;
  align-items: center;
  height: 40rpx;
}

.tbx-tooltip-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.tbx-tooltip-dot.income { background: var(--color-income); }
.tbx-tooltip-dot.expense { background: var(--color-expense); }

.tbx-tooltip-text {
  font-size: 22rpx;
  color: var(--color-text-primary);
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.tbx-tooltip-link {
  display: block;
  margin-top: 8rpx;
  padding-top: 8rpx;
  /* 分隔线走半透明：白底 token 压在磨砂玻璃上看不见 */
  border-top: 1rpx solid rgba(17, 24, 20, 0.08);
  font-size: 20rpx;
  color: var(--color-primary);
  text-align: right;
}

.tbx-tip {
  text-align: center;
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  padding-top: var(--spacing-sm);
}

/* ============ 空状态 ============ */
.tbx-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xl) 0;
}

.tbx-empty-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.tbx-empty-text {
  font-size: var(--font-sm);
  color: var(--color-text-hint);
}
