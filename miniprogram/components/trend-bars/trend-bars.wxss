/* components/trend-bars/trend-bars.wxss
   组件样式默认隔离，页面/全局的 .card 等类不会作用到这里，因此自带卡片样式
   （与 app.wxss 的 .card 保持一致）。CSS 变量定义在 page 选择器上，
   自定义属性会继承进组件，可以正常使用。 */

.tbx-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin: var(--spacing-sm) var(--spacing-md);
  box-shadow: var(--shadow-sm);
}

/* ============ 卡片头 ============ */
.tbx-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: var(--spacing-sm);
  border-bottom: 1rpx solid var(--color-divider);
}

.tbx-title {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-text-primary);
}

/* 图例：支出/收入双色，避免用户误读哪条是哪个 */
.tbx-legend {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.tbx-legend-item {
  display: flex;
  align-items: center;
}

.tbx-legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
}

.tbx-legend-dot.expense { background: var(--color-expense); }
.tbx-legend-dot.income { background: var(--color-income); }

.tbx-legend-text {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

/* ============ 翻页条 ============ */
.tbx-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-lg);
  padding: var(--spacing-sm) 0;
}

.tbx-nav-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--color-bg-page);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--color-text-secondary);
}

.tbx-nav-btn.is-disabled {
  opacity: 0.3;
}

.tbx-nav-title {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  font-weight: 500;
}

/* ============ 数据行 ============ */
.tbx-row {
  display: flex;
  align-items: center;
  padding: 14rpx 4rpx;
  border-radius: var(--radius-sm);
}

.tbx-row.is-tappable:active {
  background: var(--color-bg-page);
}

/* 时间刻度：数字是半角，2026年 ≈ 66rpx，84rpx 足够且不换行 */
.tbx-row-label {
  width: 84rpx;
  flex-shrink: 0;
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  white-space: nowrap;
  overflow: hidden;
}

.tbx-row-body {
  flex: 1;
  min-width: 0;
}

.tbx-line {
  display: flex;
  align-items: center;
  height: 18rpx;
}

.tbx-line + .tbx-line {
  margin-top: 12rpx;
}

/* 浅色轨道：给出"满格"参照，条形长度才有意义 */
.tbx-track {
  flex: 1;
  min-width: 0;
  height: 18rpx;
  background: #F5F5F5;
  border-radius: 9999rpx;
  overflow: hidden;
}

.tbx-bar {
  height: 100%;
  border-radius: 9999rpx;
  transition: width 0.35s ease;
}

.tbx-bar.expense {
  background: linear-gradient(90deg, #FF8A8A, var(--color-expense));
}

.tbx-bar.income {
  background: linear-gradient(90deg, #5FD68F, var(--color-income));
}

/* 金额独立成列，紧贴条形末端（不是压在条上） */
.tbx-amount {
  width: 168rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
  text-align: right;
  font-size: var(--font-xs);
  font-weight: 600;
  color: var(--color-expense);
  font-variant-numeric: tabular-nums;
}

.tbx-amount.income {
  color: var(--color-income);
}

/* 该时段无记录：数字保留（时间轴连续），但降为次要色，不与真实金额抢注意力 */
.tbx-amount.is-zero {
  color: var(--color-text-placeholder);
  font-weight: 400;
}

.tbx-tip {
  text-align: center;
  font-size: var(--font-xs);
  color: var(--color-text-hint);
  padding-top: var(--spacing-md);
}

/* ============ 空状态 ============ */
.tbx-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xl) 0;
}

.tbx-empty-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.tbx-empty-text {
  font-size: var(--font-sm);
  color: var(--color-text-hint);
}
